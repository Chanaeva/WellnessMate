# Production Environment Variables for Wolf Mother Wellness
# Copy this file to .env and fill in your production values

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Stripe Production Keys
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# SendGrid (Email)
SENDGRID_API_KEY=SG...

# Session Secret (generate a random 64-character string)
SESSION_SECRET=...

# Environment
NODE_ENV=production

# Production Deployment Notes:
# 1. Use live Stripe keys (sk_live_ and pk_live_) for production
# 2. Configure Stripe webhooks endpoint: https://yourdomain.com/api/stripe/webhook
# 3. Add webhook secret from Stripe dashboard
# 4. Ensure SSL/TLS is enabled for production deployment
# 5. Set up proper logging and monitoring
# 6. Configure rate limiting and security headers